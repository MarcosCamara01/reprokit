{
  "name": "atrium",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@atrium/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @atrium/db generate",
    "db:push": "pnpm --filter @atrium/db push",
    "db:studio": "pnpm --filter @atrium/db studio"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "@types/node": "^22.18.1"
  }
}
