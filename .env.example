# Copy to apps/web/.env.local for `pnpm dev`. Never commit real values.

# Control plane
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Better Auth — GitHub OAuth app (user login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (webhooks, later installation tokens)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Machine pairing JWT (not Better Auth)
MACHINE_JWT_SECRET=

# Linear OAuth app (tracker, not login). Webhook URL: $BETTER_AUTH_URL/webhooks/linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Runtime (apps/runtime) — optional Eve jobs server. Inline executeJob is the CI fallback.
# ATRIUM_EVE=0
# ATRIUM_EVE_PORT=2000
# ATRIUM_EVE_JOBS_URL=http://127.0.0.1:2000/jobs
# ATRIUM_EVE_MODEL=google/gemini-2.5-flash
# AI_GATEWAY_API_KEY=

